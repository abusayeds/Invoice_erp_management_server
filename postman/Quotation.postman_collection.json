{
  "info": {
    "_postman_id": "e8f2c314-9f3b-6d4e-af5c-2b3c4d5e6f7a",
    "name": "Quotation",
    "description": "Proposal এর মতোই। **`url`** = `http://localhost:3000/api/v1`। পাথ: `{{url}}/quotation/...`",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Quotation — Add (create)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{company}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"customer_id\": \"{{customer_id}}\",\n  \"warehouse_id\": \"{{warehouse_id}}\",\n  \"quotation_number\": \"QUO-001\",\n  \"quotation_date\": \"2026-05-14\",\n  \"due_date\": \"2026-05-28\",\n  \"discount_before_tax\": 0,\n  \"status\": \"Draft\",\n  \"notes\": \"Optional notes\",\n  \"deposit\": 0,\n  \"discount\": 0,\n  \"shipping_cost\": 0,\n  \"inline_discount\": 0,\n  \"tax\": 0,\n  \"total\": 0,\n  \"isDeleted\": false,\n  \"archive\": false,\n  \"product\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 2,\n      \"rate\": 100,\n      \"tax\": 10,\n      \"discount\": 0,\n      \"amount\": 200\n    }\n  ],\n  \"service\": []\n}"
        },
        "url": {
          "raw": "{{url}}/quotation/create",
          "host": ["{{url}}"],
          "path": ["quotation", "create"]
        },
        "description": "`rate` = প্রোডাক্টের `sellPrice`। `amount` = validateItemAmount অনুযায়ী।"
      },
      "response": []
    },
    {
      "name": "Quotation — All",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{company}}", "type": "text" }
        ],
        "url": {
          "raw": "{{url}}/quotation/all?page=1&limit=10",
          "host": ["{{url}}"],
          "path": ["quotation", "all"],
          "query": [
            { "key": "page", "value": "1" },
            { "key": "limit", "value": "10" },
            { "key": "searchTerm", "value": "", "disabled": true }
          ]
        },
        "description": "`searchTerm` — `notes`, `quotation_number`।"
      },
      "response": []
    },
    {
      "name": "Quotation — Single",
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{company}}", "type": "text" }
        ],
        "url": {
          "raw": "{{url}}/quotation/single/{{quotation_id}}",
          "host": ["{{url}}"],
          "path": ["quotation", "single", "{{quotation_id}}"]
        },
        "description": "`quotation_id` = create রেসপন্সের `_id`।"
      },
      "response": []
    },
    {
      "name": "Quotation — Edit (patch)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{company}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"Partial\",\n  \"notes\": \"Updated after review\"\n}"
        },
        "url": {
          "raw": "{{url}}/quotation/edit/{{quotation_id}}",
          "host": ["{{url}}"],
          "path": ["quotation", "edit", "{{quotation_id}}"]
        },
        "description": "আংশিক বা পূর্ণ বডি — proposal এর মতো merge + calculateInvoice।"
      },
      "response": []
    },
    {
      "name": "Quotation — Edit (full body example)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Authorization", "value": "Bearer {{company}}", "type": "text" },
          { "key": "Content-Type", "value": "application/json", "type": "text" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"quotation_number\": \"QUO-001\",\n  \"quotation_date\": \"2026-05-14\",\n  \"due_date\": \"2026-06-01\",\n  \"discount_before_tax\": 0,\n  \"status\": \"Draft\",\n  \"notes\": \"Full replace style\",\n  \"deposit\": 0,\n  \"discount\": 0,\n  \"shipping_cost\": 0,\n  \"inline_discount\": 0,\n  \"tax\": 0,\n  \"total\": 0,\n  \"isDeleted\": false,\n  \"archive\": false,\n  \"product\": [\n    {\n      \"product_id\": \"{{product_id}}\",\n      \"quantity\": 1,\n      \"rate\": 100,\n      \"tax\": 0,\n      \"discount\": 0,\n      \"amount\": 100\n    }\n  ],\n  \"service\": []\n}"
        },
        "url": {
          "raw": "{{url}}/quotation/edit/{{quotation_id}}",
          "host": ["{{url}}"],
          "path": ["quotation", "edit", "{{quotation_id}}"]
        },
        "description": "`rate`/`amount` নিয়ম create এর মতোই।"
      },
      "response": []
    },
    {
      "name": "Quotation — Delete",
      "request": {
        "method": "DELETE",
        "header": [
          { "key": "Authorization", "value": "Bearer {{company}}", "type": "text" }
        ],
        "url": {
          "raw": "{{url}}/quotation/delete/{{quotation_id}}",
          "host": ["{{url}}"],
          "path": ["quotation", "delete", "{{quotation_id}}"]
        },
        "description": "সফট ডিলিট — `isDeleted: true`, `archive: true`।"
      },
      "response": []
    }
  ],
  "variable": [
    { "key": "url", "value": "http://localhost:3000/api/v1" },
    { "key": "company", "value": "YOUR_COMPANY_JWT" },
    { "key": "customer_id", "value": "YOUR_CUSTOMER_OBJECT_ID" },
    { "key": "warehouse_id", "value": "YOUR_WAREHOUSE_OBJECT_ID" },
    { "key": "product_id", "value": "YOUR_PRODUCT_OBJECT_ID" },
    { "key": "quotation_id", "value": "REPLACE_AFTER_ADD" }
  ]
}
